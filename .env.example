# Copiá este archivo como .env y completá los valores reales.
# El archivo .env NUNCA debe commitearse al repositorio.

# ── App de check-in (checkin_app.py) ──────────────────────────
# Clave secreta de Flask (usá una cadena larga y aleatoria en producción)
SECRET_KEY=cambiar-por-una-clave-secreta-larga

# Credenciales de acceso al panel de check-in
CHECKIN_USERNAME=admin
CHECKIN_PASSWORD=evento123

# ── Generador de entradas (generar_entradas.py) ───────────────
# Contraseña de aplicación de Gmail (16 caracteres, sin espacios opcionales)
# Generarla en: Cuenta Google → Seguridad → Contraseñas de aplicación
GMAIL_PASSWORD=xxxx xxxx xxxx xxxx
